SIM_URL=http://127.0.0.1:8766

# Primary: lab Qwen endpoint. Preserve the trailing slash in its model ID.
PI_PROVIDER=openai-compatible
PI_MODEL=Qwen3.6-35B-A3B-FP8/
PI_BASE_URL=http://vic.precognition.team:8888/v1
PI_CONTEXT_WINDOW=262144
PI_MODEL_MAX_TOKENS=2048
PI_VISION=1
PI_MAX_TOKENS=2048

# The lab server requires no authentication. Set a key only if the server needs one.
PI_API_KEY=

# ZenMux: use ./zenmux.sh gemini|deepseek run/chat/monitor/model without changing Qwen defaults.
# Set ZENMUX_API_KEY in the environment or ../../.local/secrets/zenmux.env (untracked).
# The launcher selects the exact catalog model ID, RGB and reasoning_effort=low.
# ZENMUX_API_KEY=

# New-machine setup and profile validation: SETUP.md.
